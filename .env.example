# Connection string to the SAME MongoDB your real backend writes to.
# The current watcher uses polling, so a standalone MongoDB is supported.
SOURCE_MONGO_URI="MongoDB connection string"
SOURCE_DB_NAME=EdocV3_MongoDB

# Comma-separated collection names to poll.
# The current polling watcher requires at least one collection name.
WATCH_COLLECTIONS=Documents,DocumentChangeLogs

# Where the tracker stores its own events/templates. Can be the same
# cluster, just a different database, so it never mixes with app data.
TRACKER_MONGO_URI= "MongoDB connection string"
TRACKER_DB_NAME=edocv3_mongo_tracker

PORT=4400

# --- Polling mode (for standalone MongoDB without replica set) ---
# How often to poll each collection (milliseconds).
POLL_INTERVAL_MS=2000
# The field path used to detect updates. EDOCV3 documents use Audit.UpdatedDate.
UPDATED_AT_FIELD=Audit.UpdatedDate
# EDOCV3 stores DateTimeOffset as an array, so full scan is safer than date watermarks.
POLL_SCAN_MODE=full
POLL_SCAN_LIMIT=5000
# Window used to pair Documents changes with DocumentChangeLogs action names.
ACTION_LOG_WINDOW_MS=10000
# Extra time after Stop Capture to include events detected by the polling loop.
CAPTURE_GRACE_MS=5000
# How many existing documents to cache at startup without emitting insert events.
SNAPSHOT_SEED_LIMIT=1000
# Set true only when you want existing documents to appear as insert events on startup.
EMIT_INITIAL_INSERTS=false
